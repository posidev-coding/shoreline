APP_NAME="Shoreline Doors"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Cloud sessions: http://localhost:8000 (php artisan serve). Herd on the Mac: http://shoreline.test
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Same role and databases on the Mac (DBngin) and in cloud sessions (setup script).
# Laravel Cloud injects its own DB_* values. phpunit.xml forces shoreline_testing.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shoreline
DB_USERNAME=shoreline
DB_PASSWORD=shoreline

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# `private` is local storage here; on Laravel Cloud the attached bucket with this disk name replaces it.
FILESYSTEM_DISK=private
# Laravel Cloud sets QUEUE_CONNECTION=cloud when a managed queue is attached.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Locally mail goes to the log. Staging and production send through Cloudflare Email Sending:
# MAIL_MAILER=smtp, and MAIL_PASSWORD is a Cloudflare API token with Email Sending permission.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.mx.cloudflare.net
MAIL_PORT=465
MAIL_USERNAME=api_token
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@shorelinedoors.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile on the quote form; it's off when these are empty. These are
# Cloudflare's always-pass test keys. Staging and production need a real widget's keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Laravel Cloud injects bucket credentials. Set these only to point a local app at a real bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
