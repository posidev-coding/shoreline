{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "posidev/shoreline",
    "type": "project",
    "description": "Shoreline Doors: public site, back office, client portal, and QuickBooks integration.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "aws/aws-sdk-php": "^3",
        "brick/money": "^0.15.2",
        "filament/filament": "^5.10",
        "filament/spatie-laravel-media-library-plugin": "^5.10",
        "filament/spatie-laravel-settings-plugin": "^5.10",
        "guava/calendar": "^3.2",
        "laravel/framework": "^13.19",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "propaganistas/laravel-phone": "^6.1",
        "pxlrbt/filament-activity-log": "^3.1",
        "relaticle/flowforge": "^4.3",
        "ryangjchandler/laravel-cloudflare-turnstile": "^3.0",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-honeypot": "^4.7",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-one-time-passwords": "^1.1",
        "spatie/laravel-settings": "^3.10",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/schema-org": "^5.0",
        "stechstudio/filament-impersonate": "^5.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-laravel": "^5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test",
            "vendor/bin/phpstan analyse --no-progress --memory-limit=1G @no_additional_args",
            "vendor/bin/pint --test @no_additional_args"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
